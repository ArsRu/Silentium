#!/usr/bin/env bash
set -euo pipefail

services=(NetworkManager dnscrypt-proxy nftables xray apparmor)
for s in "${services[@]}"; do
  if systemctl is-enabled "$s" >/dev/null 2>&1; then
    echo "[OK] $s enabled"
  else
    echo "[WARN] $s disabled"
  fi
done

echo "Firewall mode: $(cat /etc/silentium/firewall.mode 2>/dev/null || echo unknown)"
